# Copy to backend/.env and fill in. Never commit real values.

# Supabase (server-side secret key; never expose it to the browser)
SUPABASE_URL=
SUPABASE_KEY=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# ArmorIQ (referenced by armoriq.yaml)
ARMORIQ_API_KEY=
# Shared bearer token between ArmorIQ's proxy and the MCP server
TASKMATE_MCP_BEARER_TOKEN=
# Reference only: armoriq.yaml holds the literal deployed MCP URL
TASKMATE_MCP_URL=

# Optional: ARMORIQ_OBSERVABILITY=false disables trace shipping
# ARMORIQ_OBSERVABILITY=

# Backend behaviour (optional)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TASKMATE_DEFAULT_TIMEZONE=
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_INTERVAL_SECONDS=300
REMINDER_CRON_SECRET=
LOG_LEVEL=INFO

# Optional WhatsApp Business Platform (Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v21.0

# MCP server only (defense in depth; leave unset so agent deletes stay disabled)
# TASKMATE_MCP_ALLOW_DELETE=
